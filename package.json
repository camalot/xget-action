{
  "name": "xget-action",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "GitHub Action for xget",
  "main": "lib/xget-action.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "ci": "task ci",
    "build": "ncc build --minify -o dist/setup src/setup-xget.ts && ncc build --minify -o dist/cache-save src/cache-save.ts",
    "format": "task format:fix",
    "format-check": "task format:check",
    "lint": "task lint:check",
    "lint:fix": "task lint:fix",
    "test": "task test:coverage",
    "pre-commit": "task pre-commit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camalot/xget-action.git"
  },
  "keywords": [
    "actions",
    "xget",
    "eget",
    "packages"
  ],
  "author": "camalot",
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.3.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-each": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
